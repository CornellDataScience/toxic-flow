# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is gitignored. Never commit real keys, and never paste them into
# Slack/GitHub issues/notebooks.
#
# Kraken API key permissions needed: "WebSocket interface" (for the L3 feed).
# Optional: "Query Funds" (only used as a sanity check by scripts/test_api_key.py).
# Do NOT enable trading or withdrawal permissions; this project only reads data.

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional: where recordings are written (default: ./data)
# TOXICFLOW_DATA_DIR=
